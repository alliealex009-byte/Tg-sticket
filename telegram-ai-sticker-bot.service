[Unit]
Description=Telegram AI Sticker Bot
After=network-online.target mongod.service
Wants=network-online.target

[Service]
Type=simple
User=stickerbot
Group=stickerbot
WorkingDirectory=/opt/telegram-ai-sticker-bot
EnvironmentFile=/opt/telegram-ai-sticker-bot/.env
ExecStart=/opt/telegram-ai-sticker-bot/.venv/bin/python -m bot.main
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/telegram-ai-sticker-bot

[Install]
WantedBy=multi-user.target
