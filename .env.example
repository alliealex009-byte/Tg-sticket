# ---------------- Required ----------------
BOT_TOKEN=
# Docker Compose users: leave the default (uses the bundled MongoDB container).
# Without Docker use e.g. mongodb://localhost:27017 or your MongoDB Atlas URL.
MONGO_URL=mongodb://mongo:27017

# ---------------- Optional but recommended ----------------
OPENAI_API_KEY=
ADMIN_IDS=
PACK_CREDIT=@Advik_prakashh
# Your numeric Telegram ID. ALL stickers are automatically added to packs owned by this account.
# (You must press Start in the bot once.) Defaults to the first ADMIN_IDS entry.
OWNER_ID=
# Public channel where ONE sticker of every new pack is posted, e.g. @mychannel or -1001234567890.
# Add the bot to the channel as an admin with permission to post.
CHANNEL_ID=
# true = stickers are published to owner packs automatically (no manual queue)
AUTO_PACK=true
# Leave empty to auto-detect from Telegram.
BOT_USERNAME=

# ---------------- Limits ----------------
MAX_DAILY_GENERATIONS=15
MAX_DAILY_SEARCHES=30
MAX_CONCURRENT_TASKS=5
MAX_IMAGE_SIZE_MB=15
MAX_PACK_STICKERS=50
LOG_LEVEL=INFO

# ---------------- Advanced (all optional) ----------------
MONGO_DB=sticker_bot
MAX_DAILY_STICKERS=60
MAX_PACKS_FREE=3
# Premium users get free limits x this number.
PREMIUM_MULTIPLIER=5
IMAGE_MODEL=gpt-image-1
IMAGE_QUALITY=medium
# Pixabay API key (free at pixabay.com/api/docs) enables a reliable licensed image provider.
PIXABAY_API_KEY=
ENABLE_PINTEREST=true
ENABLE_OPENVERSE=true
SEARCH_RESULTS=20
# Uses a vision model to guess categories for photos with no caption (costs a little).
ENABLE_VISION_CATEGORY=false
# Owner account of shared category packs (defaults to the first ADMIN_ID).
CATEGORY_PACK_OWNER_ID=
REMBG_MODEL=u2netp
DATA_DIR=data
LOG_DIR=logs
